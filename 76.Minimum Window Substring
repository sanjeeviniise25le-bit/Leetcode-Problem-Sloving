class Solution(object):
    def minWindow(self, s, t):
        if len(t) > len(s):
            return ""

        need = {}
        for ch in t:
            need[ch] = need.get(ch, 0) + 1

        left = 0
        count = 0
        min_len = float("inf")
        start = 0

        for right in range(len(s)):
            ch = s[right]

            if ch in need:
                if need[ch] > 0:
                    count += 1
                need[ch] -= 1

            while count == len(t):
                window_len = right - left + 1

                if window_len < min_len:
                    min_len = window_len
                    start = left

                left_ch = s[left]

                if left_ch in need:
                    need[left_ch] += 1
                    if need[left_ch] > 0:
                        count -= 1

                left += 1

        if min_len == float("inf"):
            return ""

        return s[start:start + min_len]
